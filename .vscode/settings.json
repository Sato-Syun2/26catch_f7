{
    "cmake.cmakePath": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
    "cmake.useCMakePresets": "always",
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "cmake.environment": {
        "PATH": "${env:LOCALAPPDATA}/stm32cube/bundles/ninja/1.13.2+st.1/bin;${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
    },
    "stm32cube-ide-clangd.path": "${env:LOCALAPPDATA}/stm32cube/bundles/st-arm-clangd/21.1.0+st.2/bin/starm-clangd.exe",
    "stm32cube-ide-clangd.arguments": [
        "--query-driver=${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-gcc.exe",
        "--query-driver=${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin/arm-none-eabi-g++.exe"
    ]
}
