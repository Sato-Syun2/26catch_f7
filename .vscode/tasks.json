{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure Debug",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "args": [
                "--preset",
                "Debug"
            ],
            "options": {
                "env": {
                    "PATH": "${env:LOCALAPPDATA}/stm32cube/bundles/ninja/1.13.2+st.1/bin;${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.3.1+st.1/bin/cmake.exe",
            "dependsOn": "Configure Debug",
            "dependsOrder": "sequence",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--parallel"
            ],
            "options": {
                "env": {
                    "PATH": "${env:LOCALAPPDATA}/stm32cube/bundles/ninja/1.13.2+st.1/bin;${env:LOCALAPPDATA}/stm32cube/bundles/gnu-tools-for-stm32/14.3.1+st.2/bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run STM32 (Flash and Reset)",
            "type": "process",
            "command": "${env:LOCALAPPDATA}/stm32cube/bundles/programmer/2.23.0/bin/STM32_Programmer_CLI.exe",
            "dependsOn": "Build Debug",
            "dependsOrder": "sequence",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build/Debug/26catch_f7.elf",
                "-v",
                "-rst"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
