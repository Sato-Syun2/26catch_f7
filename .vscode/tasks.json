{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure STM32 Debug",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "args": [
                "cmake", "--preset", "Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build STM32 Debug",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "dependsOn": "Configure STM32 Debug",
            "dependsOrder": "sequence",
            "args": [
                "cmake", "--build", "--preset", "Debug", "--parallel"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Configure STM32 Release",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "args": [
                "cmake", "--preset", "Release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build STM32 Release",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "dependsOn": "Configure STM32 Release",
            "dependsOrder": "sequence",
            "args": [
                "cmake", "--build", "--preset", "Release", "--parallel"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "List STM32 ST-LINK probes",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "args": [
                "programmer", "-l", "stlink-only"
            ],
            "problemMatcher": []
        },
        {
            "label": "Flash STM32 (Debug)",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "dependsOn": "Build STM32 Debug",
            "dependsOrder": "sequence",
            "args": [
                "programmer", "-c", "port=SWD",
                "-w", "${workspaceFolder}/build/Debug/26catch_f7.elf",
                "-v",
                "-rst"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash STM32 (Release)",
            "type": "shell",
            "command": "/home/taiyo/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.4.0-linux-x64/resources/binaries/linux/x86_64/cube",
            "dependsOn": "Build STM32 Release",
            "dependsOrder": "sequence",
            "args": [
                "programmer", "-c", "port=SWD",
                "-w", "${workspaceFolder}/build/Release/26catch_f7.elf",
                "-v",
                "-rst"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
